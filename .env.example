APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/leadpro

SERPER_API_KEY=
OPENAI_API_KEY=
COMPANIES_HOUSE_API_KEY=
GENERECT_API_KEY=

# openai, or manual (no OpenAI key); override per run with --llm
LLM_MODE=openai
LLM_EXTRACT_MODEL=gpt-6-luna
LLM_JUDGE_MODEL=gpt-6.1-terra
MAX_COST_PER_JOB_INR=50
