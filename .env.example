# --- app ------------------------------------------------------------------------------------------
APP_ENV=dev                 # dev | prod  (dev: search results cached for a day, pages for 30 days)
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/leadpro

# --- web console ----------------------------------------------------------------------------------
WEB_HOST=127.0.0.1          # anything beyond localhost also needs WEB_AUTH_TOKEN and TLS
WEB_PORT=8000
WEB_AUTH_TOKEN=             # access key for the console; empty = no sign-in (localhost only)
WEB_OUTPUT_DIR=output

# --- reasoning model: openai | gemini | manual (manual: an operator answers each step) -------------
LLM_MODE=gemini
OPENAI_API_KEY=
LLM_EXTRACT_MODEL=gpt-6-luna
LLM_JUDGE_MODEL=gpt-6.1-terra
GEMINI_API_KEY=             # use a paid key: the free tier is 15 requests/min and may train on inputs

# --- data providers -------------------------------------------------------------------------------
SERPER_API_KEY=             # web and news search (Google)
TINYFISH_API_KEY=           # TinySearch fallback search (free tier), TinyFetch page rendering, TinyAgent browsing
SEARCH_PROVIDER_ORDER=["serper","tinyfish"]
COMPANIES_HOUSE_API_KEY=    # free UK company registry

# --- email finders: tried in EMAIL_FINDER_ORDER, first verified address wins ----------------------
GENERECT_API_KEY=
HUNTER_API_KEY=
EMAIL_FINDER_ORDER=["generect","hunter"]
HUNTER_USD_PER_FOUND_EMAIL=0.05     # set to your Hunter plan's cost per credit
HUNTER_USD_PER_VERIFICATION=0.025

# --- spend ----------------------------------------------------------------------------------------
MAX_COST_PER_JOB_INR=50     # default cap per run; the hard ceiling is 5,000
